/dts-v1/;

#include "msm8953.dtsi"
#include "pm8953.dtsi"
#include "pmi8950.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>


/ {
	model = "Meizu M15";
	compatible = "meizu,m1871", "qcom,msm8953";
	qcom,msm-id = <0x125 0x00>;
	qcom,board-id = <0x09 0x00>;
	chassis-type = "handset";
	
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <3060000>; // 电池容量 3060mAh
		constant-charge-current-max-microamp = <2000000>; // 最大充电电流 2A
		voltage-min-design-microvolt = <3400000>; // 最低电池电压 3.4v
		voltage-max-design-microvolt = <4400000>; // 最高电池电压 4.4v
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer@90001000 {
			compatible = "simple-framebuffer";
			reg = <0 0x90001000 0 (1920 * 1080 * 3)>;

			width = <1080>;
			height = <1920>;
			stride = <(1080 * 3)>;
			format = "r8g8b8";

			power-domains = <&gcc MDSS_GDSC>;
			
			clocks = <&gcc GCC_MDSS_AHB_CLK>,
				 <&gcc GCC_MDSS_AXI_CLK>,
				 <&gcc GCC_MDSS_VSYNC_CLK>,
				 <&gcc GCC_MDSS_MDP_CLK>,
				 <&gcc GCC_MDSS_BYTE0_CLK>,
				 <&gcc GCC_MDSS_PCLK0_CLK>,
				 <&gcc GCC_MDSS_ESC0_CLK>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-volume-up {
			label = "volume_up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&tlmm 85 GPIO_ACTIVE_LOW>;
		};

        camera_snapshot {
			label = "camera_snapshot";
			gpios = <&tlmm 86 GPIO_ACTIVE_LOW>;
			linux,input-type = <0x01>;
			linux,code = <0x2fe>;
			debounce-interval = <0x0f>;
		};

        hall_sensor {
			label = "hall_sensor";
			gpios = <&tlmm 54 GPIO_ACTIVE_LOW>;
			linux,input-type = <0x01>;
			linux,code = <0x19>;
			debounce-interval = <0x0f>;
		};
	};

	reserved-memory {
		qseecom: qseecom@85b00000 {
			no-map;
			reg = <0x0 0x85b00000 0x0 0x1000000>;
		};

        cont_splash_mem: cont-splash@90001000 {
			reg = <0x00 0x90001000 0x00 0x13ff000>;
			no-map;
		};

		ramoops@9ff00000 {
			compatible = "ramoops";
			reg = <0x0 0x9ff00000 0x0 0x100000>;
			record-size = <0x1000>;
			console-size = <0x80000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x8000>;
		};
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-always-on;
		regulator-boot-on;
	};
};

&mdss_dsi0 {
	vdda-supply = <&pm8953_s3>;
	vddio-supply = <&pm8953_l6>;
	status = "okay";

	panel: panel@0 {
		reg = <0>;

		backlight = <&pmi8950_wled>;

		// reset-gpios = <&tlmm 61 GPIO_ACTIVE_LOW>;

		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&pmx_mdss_default &mdss_te_default>;
		pinctrl-1 = <&pmx_mdss_sleep &mdss_te_default>;

		vsp-supply = <&lab_vreg>;
		vsn-supply = <&ibb_vreg>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&i2c2{
    status = "okay";

	adv_bridge: bridge@39 {
		status = "okay";

		compatible = "adi,adv7533";
		reg = <0x39>;

		interrupt-parent = <&tlmm>;
		interrupts = <31 IRQ_TYPE_EDGE_FALLING>;

		adi,dsi-lanes = <4>;
		clocks = <&rpmcc RPM_SMD_BB_CLK2>;
		clock-names = "cec";

		pd-gpios = <&tlmm 0x5a 0x2002>;

		avdd-supply = <&pm8916_l6>;
		a2vdd-supply = <&pm8916_l6>;
		dvdd-supply = <&pm8916_l6>;
		pvdd-supply = <&pm8916_l6>;
		v1p2-supply = <&pm8916_l6>;
		v3p3-supply = <&pm8916_l17>;

		pinctrl-names = "default","sleep";
		pinctrl-0 = <&adv7533_int_active>;
		pinctrl-1 = <&adv7533_int_suspend>;
		#sound-dai-cells = <1>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				adv7533_in: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				adv7533_out: endpoint {
					remote-endpoint = <&hdmi_con>;
				};
			};
		};
	};

    cs35l35: cs35l35@40 {
        status = "okay";
        compatible = "cirrus,cs35l35";
        reg = <0x40>;
        VA-supply = <0xd3>;
        VP-supply = <0xe5>;
        reset-gpios = <0xbe 0x8c 0x01>;
        interrupt-parent = <0xbe>;
        interrupts = <0x8b 0x08>;
        cirrus,boost-ctl-millivolt = <9000>;

        cirrus,stereo-config;
        cirrus,audio-channel = <0x00>;
        cirrus,advisory-channel = <0x01>;
        cirrus,shared-boost;

        cirrus,classh-internal-algo {
            cirrus,classh-bst-overide;
            cirrus,classh-bst-max-limit = <0x01>;
            cirrus,classh-mem-depth = <0x01>;
            cirrus,classh-release-rate = <0x08>;
            cirrus,classh-headroom-millivolt = <0x0B>;
            cirrus,classh-wk-fet-disable = <0x01>;
            cirrus,classh-wk-fet-delay = <0x04>;
            cirrus,classh-wk-fet-thld = <0x01>;
            cirrus,classh-vpch-auto = <0x01>;
            cirrus,classh-vpch-rate = <0x02>;
            cirrus,classh-vpch-man = <0x05>;
        };

        /* Depth, Location, Frame */
        cirrus,monitor-signal-format {
            cirrus,imon = /bits/ 8 <0x03 0x00 0x01>;
            cirrus,vmon = /bits/ 8 <0x03 0x00 0x00>;
            cirrus,vpmon = /bits/ 8 <0x03 0x04 0x00>;
            cirrus,vbstmon = /bits/ 8 <0x03 0x04 0x01>;
            cirrus,vpbrstat = /bits/ 8 <0x00 0x04 0x00>;
            cirrus,zerofill = /bits/ 8 <0x00 0x00 0x00>;
        };
    };

    bq25601@6B {
		status = "okay";
		compatible = "ti,bq25601-charger";
		reg = <0x6b>;
		ti,bq2560x,vlim = <0x432380>;
		ti,bq2560x,ilim = <0x1e8480>;
		ti,bq2560x,ichg = <0x1e8480>;
		ti,bq2560x,vreg = <0x432380>;
		ti,bq2560x,stat-pin-ctrl = <0x00>;
		ti,bq2560x,precharge-current = <0x2bf20>;
		ti,bq2560x,termination-current = <0x2bf20>;
		ti,bq2560x,boost-voltage = <0x4e9530>;
		ti,bq2560x,boost-current = <0x124f80>;
		ti,bq2560x,vac-ovp-threshold = <0xda3360>;
		pinctrl-names = "bq2560x_low_cfg\0bq2560x_high_cfg";
		pinctrl-0 = <0xe7>;
		pinctrl-1 = <0xe8>;
	};
};

&i2c3{
    status = "okay";
    focaltech@38 {
		compatible = "focaltech,fts";
		reg = <0x38>;
		interrupt-parent = <0xbe>;
		interrupts = <0x41 0x02>;
		vdd-supply = <0xd2>;
		vcc_i2c-supply = <0xd3>;
	    pinctrl-names = "pmx_ts_active\0pmx_ts_suspend\0pmx_ts_release";
		pinctrl-0 = <0xd4 0xd5>;
		pinctrl-1 = <0xd6 0xd7>;
		pinctrl-2 = <0xd8>;
		focaltech,name = "fts_ts";
		focaltech,family-id = <0x08>;
		focaltech,reset-gpio = <0xbe 0x40 0x00>;
		focaltech,irq-gpio = <0xbe 0x41 0x2002>;
		focaltech,display-coords = <0x00 0x00 0x438 0x780>;
		focaltech,panel-coords = <0x00 0x00 0x4af 0x77f>;
		focaltech,no-force-update;
		focaltech,i2c-pull-up;
		focaltech,group-id = <0x01>;
		focaltech,hard-reset-delay-ms = <0x14>;
		focaltech,soft-reset-delay-ms = <0xc8>;
		focaltech,num-max-touches = <0x05>;
		focaltech,fw-delay-aa-ms = <0x1e>;
		focaltech,fw-delay-55-ms = <0x1e>;
		focaltech,fw-upgrade-id1 = <0x79>;
		focaltech,fw-upgrade-id2 = <0x08>;
		focaltech,fw-delay-readid-ms = <0x0a>;
		focaltech,fw-delay-era-flsh-ms = <0x7d0>;
		focaltech,fw-auto-cal;
		focaltech,resume-in-workqueue;
	};

    synaptics_dsx@70 {
		compatible = "synaptics_4310,dsx-i2c";
		reg = <0x70>;
		interrupt-parent = <0xbe>;
		interrupts = <0x41 0x2008>;
		pinctrl-names = "pmx_ts_active\0pmx_ts_suspend";
		pinctrl-0 = <0xd4 0xd5>;
		pinctrl-1 = <0xd6 0xd7>;
		synaptics_4310,ub-i2c-addr = <0x2c>;
		synaptics_4310,irq-gpio = <0xbe 0x41 0x2008>;
		synaptics_4310,irq-on-state = <0x00>;
		synaptics_4310,x-flip = <0x01>;
		synaptics_4310,y-flip = <0x01>;
		synaptics_4310,power-delay-ms = <0xc8>;
		synaptics_4310,reset-delay-ms = <0xc8>;
		synaptics_4310,reset-on-state = <0x00>;
		synaptics_4310,reset-active-ms = <0x14>;
	};

	synaptics_dsx@20 {
		compatible = "synaptics,dsx-i2c";
		reg = <0x20>;
		interrupt-parent = <0xbe>;
		interrupts = <0x41 0x2008>;
		pinctrl-names = "pmx_ts_active\0pmx_ts_suspend";
		pinctrl-0 = <0xd4 0xd5>;
		pinctrl-1 = <0xd6 0xd7>;
		synaptics,ub-i2c-addr = <0x2c>;
		synaptics,irq-gpio = <0xbe 0x41 0x2008>;
		synaptics,irq-on-state = <0x00>;
		synaptics,power-delay-ms = <0xc8>;
		synaptics,reset-delay-ms = <0xc8>;
		synaptics,reset-on-state = <0x00>;
		synaptics,reset-active-ms = <0x14>;
	};

	novatek@62 {
		compatible = "novatek,NVT-ts";
		reg = <0x62>;
		status = "ok";
		novatek,irq-gpio = <0xbe 0x41 0x2001>;

		novatek-mp-criteria-nvtpid@0 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "novatek-mp-criteria-nvtpid";
			IC_X_CFG_SIZE = <0x12>;
			IC_Y_CFG_SIZE = <0x20>;
			IC_KEY_CFG_SIZE = <0x04>;
			X_Channel = <0x12>;
			Y_Channel = <0x1e>;
			AIN_X = <0x11 0x10 0x0f 0x0e 0x0d 0x0c 0x0b 0x0a 0x09 0x08 0x07 0x06 0x05 0x04 0x03 0x02 0x01 0x00>;
			AIN_Y = <0xff 0xff 0x1d 0x1c 0x1b 0x1a 0x19 0x18 0x17 0x16 0x15 0x14 0x13 0x12 0x11 0x10 0x0f 0x0e 0x0d 0x0c 0x0b 0x0a 0x09 0x08 0x07 0x06 0x05 0x04 0x03 0x02 0x01 0x00>;
			AIN_KEY = <0x00 0x01 0x02 0xff>;
			PS_Config_Lmt_Short_Rawdata_P = <0x4e20>;
			PS_Config_Lmt_Short_Rawdata_N = <0x2d1e>;
			PS_Config_Lmt_Key_Short_Rawdata_P = <0x4e20>;
			PS_Config_Lmt_Key_Short_Rawdata_N = <0x2d1e>;
			PS_Config_Lmt_Short_Diff_P = <0x189c>;
			PS_Config_Lmt_Short_Diff_N = <0x00>;
			PS_Config_Lmt_Key_Short_Diff_P = <0x189c>;
			PS_Config_Lmt_Key_Short_Diff_N = <0x00>;
			PS_Config_Lmt_Short_Base_P = <0x7d0>;
			PS_Config_Lmt_Short_Base_N = <0xfffff830>;
			PS_Config_Lmt_Key_Short_Base_P = <0x7d0>;
			PS_Config_Lmt_Key_Short_Base_N = <0xfffff830>;
