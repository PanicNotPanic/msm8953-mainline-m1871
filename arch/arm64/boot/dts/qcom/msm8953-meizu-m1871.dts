&i2c5{
    clock-frequency = <0xf4240>;
    status = "okay";

    &ktd2026{
        status = "okay";
        reg = <0x30>;

        led@0 {
            reg = <0>;
            led-max-microamp = <5000>;
            function = LED_FUNCTION_INDICATOR;
            color = <LED_COLOR_ID_RED>;
        };
    };

    &aw2027_led {
        status = "okay";
        reg = <0x64>;

        led@0 {
            reg = <0>;
            led-max-microamp = <5000>;
            function = LED_FUNCTION_INDICATOR;
            color = <LED_COLOR_ID_RED>;
        };
    };

    dw7912@59 {
		compatible = "meizu,dw7912";
		reg = <0x59>;
		dw7912,power-gpio = <0xbe 0x3b 0x00>;
		status = "okay";
	};
};

&i2c8{
    clock-frequency = <0x186a0>;
    status = "okay";

    cs_m63@26 {
		compatible = "nif,ni_samd10";
		nif,max_pres = <0x800>;
		nif,irq-gpio = <0xbe 0x5b 0x2001>;
		nif,power-gpio = <0xbe 0x32 0x00>;
		reg = <0x26>;
		status = "okay";
	};
};

&tlmm{
    adv7533_int_active: adv533-int-active-state {
		pins = "gpio90";
		function = "gpio";

		drive-strength = <16>;
		bias-disable;
	};

	adv7533_int_suspend: adv7533-int-suspend-state {
		pins = "gpio90";
		function = "gpio";

		drive-strength = <2>;
		bias-disable;
	};
};